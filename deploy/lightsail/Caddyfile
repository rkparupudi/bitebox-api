{$APP_DOMAIN} {
	root * /srv/web
	encode gzip
	# Single-page app: unknown paths serve index.html so React Router can handle them.
	try_files {path} /index.html
	file_server
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

{$API_DOMAIN} {
	encode gzip
	# Caddy proxies WebSockets (Socket.IO) automatically.
	reverse_proxy api:3000
}
